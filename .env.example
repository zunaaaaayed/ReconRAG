# Environment variables use the RECONRAG_ prefix.
RECONRAG_APP_NAME=ReconRAG
RECONRAG_PAPERS_DIR=papers
RECONRAG_QDRANT_PATH=data/qdrant
RECONRAG_DATABASE_PATH=data/reconrag.db
RECONRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RECONRAG_RETRIEVAL_TOP_K=5
RECONRAG_GENERATION_MODEL=gemma4:e2b
RECONRAG_OLLAMA_HOST=http://localhost:11434
RECONRAG_GENERATION_MAX_TOKENS=500
RECONRAG_CHUNK_TARGET_TOKENS=350
RECONRAG_CHUNK_OVERLAP_TOKENS=50
